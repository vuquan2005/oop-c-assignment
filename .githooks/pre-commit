#!/bin/bash

REPO_DIR="$(git rev-parse --show-toplevel)"
cd "$REPO_DIR"

echo "=== [Pre-commit Hook] ==="

# Define path to sync_todo.py
SYNC_SCRIPT="$REPO_DIR/scripts/sync_todo.py"

"$SYNC_SCRIPT"

if [ $? -ne 0 ]; then
    echo "Sync failed. Commit aborted."
    exit 1
fi

git add TODO.md src/*/README.md 2>/dev/null || true

echo "=== [Pre-commit Hook] Done ==="
